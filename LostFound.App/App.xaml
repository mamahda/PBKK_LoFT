<Application x:Class="LostFound.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LostFound.App.ViewModels"
             xmlns:views="clr-namespace:LostFound.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel → View. ViewModel tidak pernah membuat View secara langsung. -->
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShellViewModel}">
                <views:ShellView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FoundDashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LostDashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PostDetailViewModel}">
                <views:PostDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PostFormViewModel}">
                <views:PostFormView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MyPostsViewModel}">
                <views:MyPostsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
