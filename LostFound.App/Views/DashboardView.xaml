<UserControl x:Class="LostFound.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dipakai oleh Dashboard Barang Temuan dan Dashboard Laporan Kehilangan. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Judul -->
        <Grid Margin="32,28,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CreateButtonText}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Pencarian dan filter -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="32,0,32,12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Baris 1: kata kunci, kategori, lokasi -->
                <Grid Grid.Row="0" Grid.Column="0">
                    <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding SearchPlaceholder}"
                             Padding="34,0,10,0" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                </Grid>
                <ComboBox Grid.Row="0" Grid.Column="2"
                          ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory}" />
                <TextBox Grid.Row="0" Grid.Column="4"
                         Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Filter lokasi" />

                <!-- Baris 2: rentang tanggal, urutan, reset -->
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DateFromLabel}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding DateFrom}" DisplayDateEnd="{Binding Today, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="s.d." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0" />
                    <DatePicker Grid.Column="3" SelectedDate="{Binding DateTo}" DisplayDateEnd="{Binding Today, Mode=OneWay}" />

                    <TextBlock Grid.Column="5" Text="Urutkan" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="6" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" />
                    <Button Grid.Column="7" Style="{StaticResource GhostButton}" Content="Reset" Command="{Binding ResetFiltersCommand}" Margin="8,0,0,0" />
                    <Button Grid.Column="8" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" ToolTip="Muat ulang" Margin="4,0,0,0">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Ringkasan hasil -->
        <Grid Grid.Row="2" Margin="32,0,32,8">
            <TextBlock Text="{Binding ResultText}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            <ProgressBar Style="{StaticResource ThinProgress}" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Kartu -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="26,0,26,28">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Command="{Binding OpenCommand}" Width="236" Margin="6">
                                <StackPanel>
                                    <Grid Height="156">
                                        <Border CornerRadius="8,8,0,0" Background="{StaticResource SurfaceAltBrush}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="&#xE91B;" Style="{StaticResource IconText}" FontSize="22"
                                                           Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Tidak ada foto" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="8,8,0,0">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="14,12,14,14">
                                        <TextBlock Text="{Binding ItemName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource Chip}" Margin="0,8,0,10">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE707;" Style="{StaticResource IconText}" FontSize="12"
                                                       Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding LocationText}" Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="&#xE787;" Style="{StaticResource IconText}" FontSize="12"
                                                       Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding DateText}" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Kosong -->
                <StackPanel Margin="0,48,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="28"
                               Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>

                <Button Style="{StaticResource SecondaryButton}" Content="Tampilkan lebih banyak" Command="{Binding LoadMoreCommand}"
                        HorizontalAlignment="Center" Margin="0,16,0,0"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
