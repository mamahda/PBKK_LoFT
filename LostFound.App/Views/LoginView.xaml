<UserControl x:Class="LostFound.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:LostFound.App.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid MinHeight="560">
            <StackPanel Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32">

                <!-- Judul aplikasi -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="20"
                                   Foreground="{StaticResource WhiteBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Lost and Found" Style="{StaticResource PageTitleText}" HorizontalAlignment="Center" Margin="0,14,0,2" />
                    <TextBlock Text="Departemen Teknik Informatika" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                </StackPanel>

                <Border Style="{StaticResource Panel}" Padding="28">
                    <StackPanel>
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitleText}" FontSize="18" Margin="0,0,0,18" />

                        <!-- Nama lengkap (registrasi) -->
                        <StackPanel Margin="0,0,0,14" Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Nama lengkap" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                            <TextBlock Text="{Binding FullNameError}" Style="{StaticResource FieldError}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="NRP" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="IdentityBox" Text="{Binding IdentityNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
                            <TextBlock Text="{Binding IdentityNumberError}" Style="{StaticResource FieldError}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Kata sandi" Style="{StaticResource FieldLabel}" />
                            <PasswordBox helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}" MaxLength="128" />
                            <TextBlock Text="{Binding PasswordError}" Style="{StaticResource FieldError}" />
                        </StackPanel>

                        <!-- Konfirmasi kata sandi (registrasi) -->
                        <StackPanel Margin="0,0,0,14" Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Konfirmasi kata sandi" Style="{StaticResource FieldLabel}" />
                            <PasswordBox helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" MaxLength="128" />
                            <TextBlock Text="{Binding ConfirmPasswordError}" Style="{StaticResource FieldError}" />
                        </StackPanel>

                        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>

                        <Button Content="{Binding SubmitText}"
                                Command="{Binding SubmitCommand}"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButton}"
                                Height="38"
                                Margin="0,4,0,0" />

                        <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,8,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Text="{Binding TogglePrompt}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <Button Content="{Binding ToggleText}" Command="{Binding ToggleModeCommand}" Style="{StaticResource LinkButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
