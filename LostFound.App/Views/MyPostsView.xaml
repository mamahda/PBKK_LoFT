<UserControl x:Class="LostFound.App.Views.MyPostsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,28,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Posting Saya" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding ArchiveHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Buat Posting" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Tab Temuan/Kehilangan dan sub-tab Aktif/Arsip -->
        <Grid Grid.Row="1" Margin="32,0,32,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SegmentContainer}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Temuan" IsChecked="{Binding IsFoundTab, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Kehilangan" IsChecked="{Binding IsLostTab, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SegmentContainer}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Aktif" IsChecked="{Binding IsActiveTab, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Arsip" IsChecked="{Binding IsArchiveTab, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <ProgressBar Grid.Column="3" Style="{StaticResource ThinProgress}" VerticalAlignment="Bottom" Margin="16,0,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="32,0,32,28">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="96" Height="72">
                                        <Border CornerRadius="6" Background="{StaticResource SurfaceAltBrush}">
                                            <TextBlock Text="&#xE91B;" Style="{StaticResource IconText}" FontSize="18"
                                                       Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center"
                                                       Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Border>
                                        <Border CornerRadius="6">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Category, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding DateText, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding LocationText, Mode=OneWay}" />
                                        </TextBlock>
                                        <Border Margin="0,8,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                            <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Content="{Binding StatusActionText}"
                                                Command="{Binding StatusActionCommand}" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource GhostButton}" Content="Lihat detail" Command="{Binding OpenCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,48,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE77B;" Style="{StaticResource IconText}" FontSize="28"
                               Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
