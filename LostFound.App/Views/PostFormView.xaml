<UserControl x:Class="LostFound.App.Views.PostFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Satu form untuk barang temuan dan kehilangan; juga dipakai untuk edit. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,24,32,32" MaxWidth="760" HorizontalAlignment="Stretch">

            <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="-10,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Kembali" />
                </StackPanel>
            </Button>

            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

            <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,0,0,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource Panel}" Padding="24">
                <StackPanel>
                    <!-- Jenis posting (hanya saat membuat posting baru) -->
                    <StackPanel Margin="0,0,0,18" Visibility="{Binding CanChangeKind, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Jenis posting" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource SegmentContainer}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="Saya menemukan barang" IsChecked="{Binding IsFound, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="Saya kehilangan barang" IsChecked="{Binding IsLost, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Nama barang" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 Tag="Contoh: Dompet kulit cokelat" />
                        <TextBlock Text="{Binding ItemNameError}" Style="{StaticResource FieldError}" />
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kategori" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" />
                            <TextBlock Text="{Binding CategoryError}" Style="{StaticResource FieldError}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding DateLabel}" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding Date}" DisplayDateEnd="{Binding Today, Mode=OneWay}" />
                            <TextBlock Text="{Binding DateError}" Style="{StaticResource FieldError}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{Binding LocationLabel}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"
                                 Tag="Contoh: Ruang IF-105, Gedung Teknik Informatika" />
                        <TextBlock Text="{Binding LocationError}" Style="{StaticResource FieldError}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <Grid>
                            <TextBlock Text="{Binding DescriptionLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding DescriptionCounter}" FontSize="12" Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="{Binding DescriptionMaxLength}"
                                 Height="110"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 Tag="Ciri-ciri barang dan keterangan singkat" />
                        <TextBlock Text="{Binding DescriptionError}" Style="{StaticResource FieldError}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Kontak yang bisa dihubungi" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 Tag="Nomor WhatsApp, email, atau lainnya" />
                        <TextBlock Text="{Binding ContactError}" Style="{StaticResource FieldError}" />
                    </StackPanel>

                    <!-- Foto -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding PhotoLabel}" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Height="160">
                                <Border CornerRadius="8" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="&#xE91B;" Style="{StaticResource IconText}" FontSize="24"
                                                   Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Belum ada foto" FontSize="12" Foreground="{StaticResource TextSubtleBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PhotoPreview}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding PhotoButtonText}" Command="{Binding PickPhotoCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Content="Hapus foto" Command="{Binding RemovePhotoCommand}" Margin="8,0,0,0"
                                            Visibility="{Binding CanRemovePhoto, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Text="JPG atau PNG, maksimal 5 MB." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding PhotoError}" Style="{StaticResource FieldError}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,16" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ProgressBar Style="{StaticResource ThinProgress}" Width="80" VerticalAlignment="Center" Margin="0,0,12,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Batal" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding SaveText}" Command="{Binding SaveCommand}" MinWidth="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
