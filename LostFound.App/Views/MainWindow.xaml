<Window x:Class="LostFound.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lost and Found · Departemen Teknik Informatika"
        Width="1240" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <!-- Layar aktif: login atau shell (dipilih lewat DataTemplate di App.xaml). -->
        <ContentControl Content="{Binding Current}" Focusable="False" />

        <!-- Snackbar -->
        <Border DataContext="{Binding Snackbar}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="24"
                MinWidth="280"
                MaxWidth="640"
                Padding="16,10,8,10"
                CornerRadius="8"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SnackbarBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.2" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Message}"
                           Foreground="{StaticResource WhiteBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Height="26"
                        Padding="8,0"
                        Content="Tutup"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource GhostButton}"
                        Foreground="{StaticResource WhiteBrush}"
                        Background="Transparent" />
            </Grid>
        </Border>
    </Grid>
</Window>
