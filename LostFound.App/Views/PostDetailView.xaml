<UserControl x:Class="LostFound.App.Views.PostDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,24,32,32" MaxWidth="1040" HorizontalAlignment="Stretch">

            <Button Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="-10,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Kembali" />
                </StackPanel>
            </Button>

            <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,0,0,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Posting tidak ditemukan -->
            <Border Style="{StaticResource Panel}" Visibility="{Binding NotFound, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,24">
                    <TextBlock Text="Posting tidak ditemukan" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" />
                    <TextBlock Text="Posting mungkin sudah dihapus atau tidak dapat dilihat." Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Isi posting -->
            <StackPanel Visibility="{Binding HasPost, Converter={StaticResource BoolToVisibility}}">

                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                               Text="Posting ini ada di arsip dan hanya terlihat oleh Anda. Aktifkan kembali jika status diubah karena keliru." />
                </Border>

                <Border Style="{StaticResource Panel}" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Foto -->
                        <Grid Height="300" VerticalAlignment="Top">
                            <Border CornerRadius="8" Background="{StaticResource SurfaceAltBrush}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="&#xE91B;" Style="{StaticResource IconText}" FontSize="32"
                                               Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Tidak ada foto" Foreground="{StaticResource TextSubtleBrush}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Photo}" Stretch="Uniform" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- Informasi -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding KindLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="{Binding ItemName}" Style="{StaticResource PageTitleText}" TextWrapping="Wrap" Margin="0,4,0,10" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding LocationLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding LocationText}" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <TextBlock Text="{Binding DateLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DateText}" Margin="0,0,0,14" />

                            <TextBlock Text="Deskripsi" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding Description, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,0,0,14" />

                            <TextBlock Text="Kontak" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="6" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,18">
                                <TextBox Text="{Binding Contact, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                         FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12" />
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap">
                                <Run Text="Diposting oleh" />
                                <Run Text="{Binding OwnerName, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="·" />
                                <Run Text="{Binding CreatedText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                                       Visibility="{Binding UpdatedText, Converter={StaticResource NullToVisibility}}">
                                <Run Text="Diperbarui" />
                                <Run Text="{Binding UpdatedText, Mode=OneWay}" />
                            </TextBlock>

                            <!-- Aksi -->
                            <WrapPanel Margin="0,20,0,0" Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ResolveCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding CanResolve, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding ResolveText}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ReactivateCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding CanReactivate, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7A7;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Aktifkan kembali" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Edit" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerOutlineButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Hapus" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}" Command="{Binding TakedownCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding CanTakedown, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Takedown" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
